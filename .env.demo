# Used only by `npm run dev:demo` (vite --mode demo).
# Blanking the Firebase keys here overrides whatever real credentials are in
# .env for this mode, so isFirebaseConfigured() is false and the app skips
# Google sign-in entirely and runs on the browser-local fallback "database"
# (see SetupBanner / "Local DB Mode" in the app). No secrets live here -
# safe to commit.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
