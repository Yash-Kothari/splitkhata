# Firebase project credentials - only used by scripts/check-card-data.mjs
# now that the Vite app (which originally read these as VITE_FIREBASE_*) has
# been removed. Keeping the same key names since the script already reads
# them as-is.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
