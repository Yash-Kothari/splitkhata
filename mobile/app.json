{
  "expo": {
    "name": "Splitkhata",
    "slug": "splitkhata",
    "scheme": "splitkhata",
    "version": "3.0.8",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F2ECDD",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.splitkhata.mobile",
      "deploymentTarget": "17.0",
      "config": {
        "usesNonExemptEncryption": false
      },
      "buildNumber": "10"
    },
    "android": {
      "package": "com.splitkhata.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#3D7068",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "versionCode": 10
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "themeColor": "#3D7068",
      "backgroundColor": "#F2ECDD",
      "description": "Shared household, travel and credit card expense ledger."
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#F2ECDD",
      "resizeMode": "contain"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Splitkhata to use the camera to scan receipts.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/withUiSceneManifest.js",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "baseUrl": "/splitkhata"
    }
  }
}
