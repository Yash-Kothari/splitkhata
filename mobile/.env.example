# Google OAuth client IDs for Sign-In (see README.md "Google Sign-In setup")
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Set to "true" to point Firestore AND Auth at local emulators instead of
# prod - run `firebase emulators:start --only firestore,auth` from the repo
# root first. Also skips the real Google sign-in screen entirely (auto-signs
# in as a fake test user against the Auth emulator), so this is the fastest
# way to run the app locally without a Google account or real household data.
# Leave unset/false for normal use against the real household data.
EXPO_PUBLIC_USE_FIRESTORE_EMULATOR=
